{
  "$id": "https://agent-continuity-guard.dev/schemas/v1/producer-identity.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "name": {
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+:/-]*$",
      "type": "string"
    },
    "version": {
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+:/-]*$",
      "type": "string"
    }
  },
  "required": ["digest", "name", "version"],
  "title": "ProducerIdentity/v1",
  "type": "object",
  "x-record-type": "ProducerIdentity/v1"
}
