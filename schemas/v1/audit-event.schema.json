{
  "$id": "https://agent-continuity-guard.invalid/schemas/v1/audit-event.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "details": {
      "type": "object"
    },
    "head_updates": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "expected": {
            "oneOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "audit_event_id": {
                    "$ref": "#/$defs/digest"
                  },
                  "audit_sequence": {
                    "minimum": 1,
                    "type": "integer"
                  },
                  "record_id": {
                    "$ref": "#/$defs/digest"
                  }
                },
                "required": [
                  "audit_event_id",
                  "audit_sequence",
                  "record_id"
                ],
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
            "type": "string"
          },
          "new_record_id": {
            "$ref": "#/$defs/digest"
          }
        },
        "required": [
          "expected",
          "name",
          "new_record_id"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "inserted_record_ids": {
      "items": {
        "$ref": "#/$defs/digest"
      },
      "type": "array",
      "uniqueItems": true
    },
    "kind": {
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+:/-]*$",
      "type": "string"
    },
    "local_values": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "digest": {
            "$ref": "#/$defs/digest"
          },
          "kind": {
            "enum": [
              "criterion_text",
              "goal_text"
            ]
          }
        },
        "required": [
          "digest",
          "kind"
        ],
        "type": "object"
      },
      "type": "array",
      "uniqueItems": true
    },
    "logical_time": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    },
    "previous_event_id": {
      "oneOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "record_ids": {
      "items": {
        "$ref": "#/$defs/digest"
      },
      "type": "array",
      "uniqueItems": true
    },
    "sequence": {
      "minimum": 1,
      "type": "integer"
    },
    "store_id": {
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+:/-]*$",
      "type": "string"
    },
    "subject_id": {
      "$ref": "#/$defs/digest"
    }
  },
  "required": [
    "details",
    "head_updates",
    "inserted_record_ids",
    "kind",
    "local_values",
    "logical_time",
    "previous_event_id",
    "record_ids",
    "sequence",
    "store_id",
    "subject_id"
  ],
  "title": "AuditEvent/v1",
  "type": "object",
  "x-record-type": "AuditEvent/v1",
  "$defs": {
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  }
}
