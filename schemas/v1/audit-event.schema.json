{
  "$id": "https://agent-continuity-guard.invalid/schemas/v1/audit-event.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "details": {
      "$ref": "#/$defs/auditDetails"
    },
    "head_updates": {
      "additionalProperties": {
        "$ref": "#/$defs/headUpdate"
      },
      "minProperties": 1,
      "propertyNames": {
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
      },
      "type": "object"
    },
    "inserted_record_ids": {
      "items": {
        "$ref": "#/$defs/digest"
      },
      "type": "array",
      "uniqueItems": true
    },
    "kind": {
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+:/-]*$",
      "type": "string"
    },
    "local_values": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "digest": {
            "$ref": "#/$defs/digest"
          },
          "kind": {
            "enum": [
              "criterion_text",
              "goal_text"
            ]
          }
        },
        "required": [
          "digest",
          "kind"
        ],
        "type": "object"
      },
      "type": "array",
      "uniqueItems": true
    },
    "logical_time": {
      "$ref": "#/$defs/logicalTime"
    },
    "previous_event_id": {
      "oneOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "record_ids": {
      "items": {
        "$ref": "#/$defs/digest"
      },
      "type": "array",
      "uniqueItems": true
    },
    "sequence": {
      "minimum": 1,
      "type": "integer"
    },
    "store_id": {
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+:/-]*$",
      "type": "string"
    },
    "subject_id": {
      "$ref": "#/$defs/digest"
    }
  },
  "required": [
    "details",
    "head_updates",
    "inserted_record_ids",
    "kind",
    "local_values",
    "logical_time",
    "previous_event_id",
    "record_ids",
    "sequence",
    "store_id",
    "subject_id"
  ],
  "title": "AuditEvent/v1",
  "type": "object",
  "x-record-type": "AuditEvent/v1",
  "$defs": {
    "auditDetails": {
      "allOf": [
        {
          "$ref": "#/$defs/auditDetailsBase"
        },
        {
          "properties": {
            "items": {
              "items": {
                "$ref": "#/$defs/auditDetailsDepth1"
              }
            }
          }
        }
      ]
    },
    "auditDetailsBase": {
      "additionalProperties": false,
      "maxProperties": 64,
      "properties": {
        "count": {
          "minimum": 0,
          "type": "integer"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "digests": {
          "items": {
            "$ref": "#/$defs/digest"
          },
          "maxItems": 64,
          "type": "array",
          "uniqueItems": true
        },
        "flag": {
          "type": "boolean"
        },
        "items": {
          "maxItems": 64,
          "type": "array",
          "uniqueItems": true
        },
        "logical_time": {
          "$ref": "#/$defs/logicalTime"
        },
        "record_id": {
          "$ref": "#/$defs/digest"
        },
        "record_ids": {
          "items": {
            "$ref": "#/$defs/digest"
          },
          "maxItems": 64,
          "type": "array",
          "uniqueItems": true
        },
        "sequence": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "auditDetailsDepth1": {
      "allOf": [
        {
          "$ref": "#/$defs/auditDetailsBase"
        },
        {
          "properties": {
            "items": {
              "items": {
                "$ref": "#/$defs/auditDetailsDepth2"
              }
            }
          }
        }
      ]
    },
    "auditDetailsDepth2": {
      "allOf": [
        {
          "$ref": "#/$defs/auditDetailsBase"
        },
        {
          "properties": {
            "items": {
              "items": {
                "$ref": "#/$defs/auditDetailsDepth3"
              }
            }
          }
        }
      ]
    },
    "auditDetailsDepth3": {
      "allOf": [
        {
          "$ref": "#/$defs/auditDetailsBase"
        },
        {
          "properties": {
            "items": {
              "items": {
                "$ref": "#/$defs/auditDetailsDepth4"
              }
            }
          }
        }
      ]
    },
    "auditDetailsDepth4": {
      "allOf": [
        {
          "$ref": "#/$defs/auditDetailsBase"
        },
        {
          "properties": {
            "items": {
              "items": {
                "$ref": "#/$defs/auditDetailsDepth5"
              }
            }
          }
        }
      ]
    },
    "auditDetailsDepth5": {
      "allOf": [
        {
          "$ref": "#/$defs/auditDetailsBase"
        },
        {
          "properties": {
            "items": {
              "items": {
                "$ref": "#/$defs/auditDetailsDepth6"
              }
            }
          }
        }
      ]
    },
    "auditDetailsDepth6": {
      "allOf": [
        {
          "$ref": "#/$defs/auditDetailsBase"
        },
        {
          "properties": {
            "items": {
              "items": {
                "$ref": "#/$defs/auditDetailsDepth7"
              }
            }
          }
        }
      ]
    },
    "auditDetailsDepth7": {
      "allOf": [
        {
          "$ref": "#/$defs/auditDetailsBase"
        },
        {
          "properties": {
            "items": {
              "items": {
                "$ref": "#/$defs/auditDetailsDepth8"
              }
            }
          }
        }
      ]
    },
    "auditDetailsDepth8": {
      "allOf": [
        {
          "$ref": "#/$defs/auditDetailsBase"
        },
        {
          "properties": {
            "items": {
              "maxItems": 0
            }
          }
        }
      ]
    },
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "headState": {
      "additionalProperties": false,
      "properties": {
        "audit_event_id": {
          "$ref": "#/$defs/digest"
        },
        "audit_sequence": {
          "minimum": 1,
          "type": "integer"
        },
        "record_id": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "audit_event_id",
        "audit_sequence",
        "record_id"
      ],
      "type": "object"
    },
    "headUpdate": {
      "additionalProperties": false,
      "properties": {
        "expected": {
          "oneOf": [
            {
              "$ref": "#/$defs/headState"
            },
            {
              "type": "null"
            }
          ]
        },
        "new_record_id": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "expected",
        "new_record_id"
      ],
      "type": "object"
    },
    "logicalTime": {
      "pattern": "^(?:(?:[0-9]{3}[1-9]|[0-9]{2}[1-9][0-9]|[0-9][1-9][0-9]{2}|[1-9][0-9]{3})-(?:(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01]))|(?:(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30))|(?:02-(?:0[1-9]|1[0-9]|2[0-8])))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:0[48]|[2468][048]|[13579][26])00)-02-29)T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$",
      "type": "string"
    }
  }
}
