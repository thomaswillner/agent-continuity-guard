{
  "$id": "https://agent-continuity-guard.invalid/schemas/v1/audit-event.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "details": {
      "$ref": "#/$defs/auditDetails"
    },
    "head_updates": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "expected": {
            "oneOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "audit_event_id": {
                    "$ref": "#/$defs/digest"
                  },
                  "audit_sequence": {
                    "minimum": 1,
                    "type": "integer"
                  },
                  "record_id": {
                    "$ref": "#/$defs/digest"
                  }
                },
                "required": [
                  "audit_event_id",
                  "audit_sequence",
                  "record_id"
                ],
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
            "type": "string"
          },
          "new_record_id": {
            "$ref": "#/$defs/digest"
          }
        },
        "required": [
          "expected",
          "name",
          "new_record_id"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "inserted_record_ids": {
      "items": {
        "$ref": "#/$defs/digest"
      },
      "type": "array",
      "uniqueItems": true
    },
    "kind": {
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+:/-]*$",
      "type": "string"
    },
    "local_values": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "digest": {
            "$ref": "#/$defs/digest"
          },
          "kind": {
            "enum": [
              "criterion_text",
              "goal_text"
            ]
          }
        },
        "required": [
          "digest",
          "kind"
        ],
        "type": "object"
      },
      "type": "array",
      "uniqueItems": true
    },
    "logical_time": {
      "$ref": "#/$defs/logicalTime"
    },
    "previous_event_id": {
      "oneOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "record_ids": {
      "items": {
        "$ref": "#/$defs/digest"
      },
      "type": "array",
      "uniqueItems": true
    },
    "sequence": {
      "minimum": 1,
      "type": "integer"
    },
    "store_id": {
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+:/-]*$",
      "type": "string"
    },
    "subject_id": {
      "$ref": "#/$defs/digest"
    }
  },
  "required": [
    "details",
    "head_updates",
    "inserted_record_ids",
    "kind",
    "local_values",
    "logical_time",
    "previous_event_id",
    "record_ids",
    "sequence",
    "store_id",
    "subject_id"
  ],
  "title": "AuditEvent/v1",
  "type": "object",
  "x-record-type": "AuditEvent/v1",
  "$defs": {
    "auditDetails": {
      "additionalProperties": false,
      "maxProperties": 64,
      "properties": {
        "code": {
          "$ref": "#/$defs/publicIdentifier"
        },
        "count": {
          "minimum": 0,
          "type": "integer"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "digests": {
          "items": {
            "$ref": "#/$defs/digest"
          },
          "maxItems": 64,
          "type": "array",
          "uniqueItems": true
        },
        "flag": {
          "type": "boolean"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/auditDetails"
          },
          "maxItems": 64,
          "type": "array",
          "uniqueItems": true
        },
        "logical_time": {
          "$ref": "#/$defs/logicalTime"
        },
        "record_id": {
          "$ref": "#/$defs/digest"
        },
        "record_ids": {
          "items": {
            "$ref": "#/$defs/digest"
          },
          "maxItems": 64,
          "type": "array",
          "uniqueItems": true
        },
        "sequence": {
          "minimum": 0,
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/publicIdentifier"
        }
      },
      "type": "object"
    },
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "logicalTime": {
      "pattern": "^(?:(?:[0-9]{3}[1-9]|[0-9]{2}[1-9][0-9]|[0-9][1-9][0-9]{2}|[1-9][0-9]{3})-(?:(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01]))|(?:(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30))|(?:02-(?:0[1-9]|1[0-9]|2[0-8])))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:0[48]|[2468][048]|[13579][26])00)-02-29)T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$",
      "type": "string"
    },
    "publicIdentifier": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+:/-]{0,127}$",
      "type": "string"
    }
  }
}
