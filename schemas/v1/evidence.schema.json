{
  "$id": "https://agent-continuity-guard.dev/schemas/v1/evidence.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "fact": {
      "additionalProperties": false,
      "properties": {
        "field_path": {"items": {"maxLength": 64, "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$", "type": "string"}, "maxItems": 8, "minItems": 1, "type": "array"},
        "value": {"anyOf": [{"type": "null"}, {"type": "boolean"}, {"type": "integer"}, {"pattern": "^[^\\u0000-\\u001f]*$", "type": "string"}]}
      },
      "required": ["field_path", "value"],
      "type": "object"
    },
    "invalidator": {
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["citation", "evidence_dependency", "target", "checkpoint", "producer", "policy"]},
        "required": {"type": "boolean"},
        "subject_id": {"$ref": "#/$defs/digest"}
      },
      "required": ["kind", "required", "subject_id"],
      "type": "object"
    },
    "logicalTime": {"format": "date-time", "type": "string"},
    "producer": {
      "additionalProperties": false,
      "properties": {
        "digest": {"$ref": "#/$defs/digest"},
        "name": {"maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._+:/-]{0,127}$", "type": "string"},
        "version": {"maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._+:/-]{0,127}$", "type": "string"}
      },
      "required": ["digest", "name", "version"],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"authority": {"const": "deterministic"}}},
      "then": {"properties": {"facts": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"completeness": {"const": "complete"}, "kind": {"const": "command"}}, "required": ["completeness", "kind"]},
      "then": {
        "properties": {
          "collected_check_count": {"minimum": 1, "type": "integer"},
          "declared_output_digest": {"$ref": "#/$defs/digest"},
          "observed_output_digest": {"$ref": "#/$defs/digest"},
          "pagination_complete": {"const": true},
          "terminal_status": {"type": "integer"}
        }
      }
    }
  ],
  "properties": {
    "authority": {"enum": ["deterministic", "advisory"]},
    "checkpoint_id": {"$ref": "#/$defs/digest"},
    "collected_check_count": {"anyOf": [{"minimum": 0, "type": "integer"}, {"type": "null"}]},
    "completeness": {"enum": ["complete", "incomplete", "truncated", "unavailable"]},
    "declared_output_digest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "expires_at": {"anyOf": [{"$ref": "#/$defs/logicalTime"}, {"type": "null"}]},
    "facts": {"items": {"$ref": "#/$defs/fact"}, "type": "array", "uniqueItems": true},
    "invalidators": {"items": {"$ref": "#/$defs/invalidator"}, "type": "array", "uniqueItems": true},
    "kind": {"enum": ["citation", "command", "structured_claim", "target", "harness"]},
    "observed_at": {"$ref": "#/$defs/logicalTime"},
    "observed_output_digest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "pagination_complete": {"anyOf": [{"type": "boolean"}, {"type": "null"}]},
    "payload_digest": {"$ref": "#/$defs/digest"},
    "producer": {"$ref": "#/$defs/producer"},
    "subject_digest": {"$ref": "#/$defs/digest"},
    "target_id": {"$ref": "#/$defs/digest"},
    "terminal_status": {"anyOf": [{"type": "integer"}, {"type": "null"}]}
  },
  "required": ["authority", "checkpoint_id", "collected_check_count", "completeness", "declared_output_digest", "expires_at", "facts", "invalidators", "kind", "observed_at", "observed_output_digest", "pagination_complete", "payload_digest", "producer", "subject_digest", "target_id", "terminal_status"],
  "title": "Evidence/v1",
  "type": "object",
  "x-record-type": "Evidence/v1"
}
