{
  "$id": "https://agent-continuity-guard.dev/schemas/v1/target-identity.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "oid": {"pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$", "type": "string"}
  },
  "additionalProperties": false,
  "properties": {
    "adapter_id": {
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+:/-]*$",
      "type": "string"
    },
    "adapter_version": {
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+:/-]*$",
      "type": "string"
    },
    "capabilities": {
      "items": {
        "$ref": "https://agent-continuity-guard.dev/schemas/v1/capability-claim.schema.json"
      },
      "type": "array"
    },
    "filesystem_id": {
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f]+$",
      "type": "string"
    },
    "git_object_manifest_digest": {"$ref": "#/$defs/digest"},
    "head_oid": {"$ref": "#/$defs/oid"},
    "ignore_provenance_digest": {"$ref": "#/$defs/digest"},
    "index_manifest_digest": {"$ref": "#/$defs/digest"},
    "inventory_digest": {"$ref": "#/$defs/digest"},
    "physical_root_fingerprint": {"$ref": "#/$defs/digest"},
    "platform_id": {
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f]+$",
      "type": "string"
    },
    "sanitized_remote_identity_digest": {
      "anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]
    },
    "status_digest": {"$ref": "#/$defs/digest"},
    "tree_oid": {"$ref": "#/$defs/oid"},
    "worktree_manifest_digest": {"$ref": "#/$defs/digest"}
  },
  "required": [
    "adapter_id",
    "adapter_version",
    "capabilities",
    "filesystem_id",
    "git_object_manifest_digest",
    "head_oid",
    "ignore_provenance_digest",
    "index_manifest_digest",
    "inventory_digest",
    "physical_root_fingerprint",
    "platform_id",
    "sanitized_remote_identity_digest",
    "status_digest",
    "tree_oid",
    "worktree_manifest_digest"
  ],
  "title": "TargetIdentity/v1",
  "type": "object",
  "x-record-type": "TargetIdentity/v1"
}
