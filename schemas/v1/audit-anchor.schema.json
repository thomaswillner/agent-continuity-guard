{
  "$id": "https://agent-continuity-guard.invalid/schemas/v1/audit-anchor.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "audit_head_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "audit_sequence": {
      "minimum": 1,
      "type": "integer"
    },
    "created_at": {
      "$ref": "#/$defs/logicalTime"
    },
    "label": {
      "oneOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+:/-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "store_id": {
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+:/-]*$",
      "type": "string"
    }
  },
  "required": [
    "audit_head_id",
    "audit_sequence",
    "created_at",
    "label",
    "store_id"
  ],
  "title": "AuditAnchor/v1",
  "type": "object",
  "x-record-type": "AuditAnchor/v1",
  "$defs": {
    "logicalTime": {
      "pattern": "^(?:(?:[0-9]{3}[1-9]|[0-9]{2}[1-9][0-9]|[0-9][1-9][0-9]{2}|[1-9][0-9]{3})-(?:(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01]))|(?:(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30))|(?:02-(?:0[1-9]|1[0-9]|2[0-8])))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:0[48]|[2468][048]|[13579][26])00)-02-29)T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$",
      "type": "string"
    }
  }
}
