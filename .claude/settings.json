{
  "permissions": {
    "allow": [
      "Edit",
      "Glob",
      "Grep",
      "NotebookEdit",
      "Read",
      "Skill",
      "WebFetch",
      "WebSearch",
      "Write",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git push *)",
      "Bash(git switch *)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/*.key)",
      "Read(./**/*.pem)",
      "Edit(./**/.env)",
      "Edit(./**/*.key)",
      "Edit(./**/*.pem)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ]
  }
}
